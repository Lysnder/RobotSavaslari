%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fa7c1bbaa5c596149a979c75f11125bc, type: 3}
  m_Name: DrivingExerciseCatalog
  m_EditorClassIdentifier: RobotSavaslari.Gameplay::RobotSavaslari.Training.DrivingExerciseCatalog
  exercises:
  - kind: 0
    exerciseId: slalom
    rulesRevision: 1
    title: Slalom
    instruction: "Numaral\u0131 kap\u0131lar\u0131 kuzeye do\u011Fru s\u0131rayla
      ge\xE7. Ka\xE7\u0131r\u0131lan kap\u0131 veya sert temas turu ge\xE7ersiz k\u0131lar."
    start: {x: -2.4, y: 0, z: -5.5}
    startYaw: 0
    gates:
    - position: {x: -3.1, y: 0, z: -3.1}
      radius: 0.85
    - position: {x: -1.3, y: 0, z: -0.7}
      radius: 0.85
    - position: {x: -3.1, y: 0, z: 1.7}
      radius: 0.85
    - position: {x: -1.3, y: 0, z: 4.3}
      radius: 0.85
    targetYaw: 0
    yawTolerance: 0
    stopSpeed: 0.15
    dwellSeconds: 1
  - kind: 1
    exerciseId: controlled-stop
    rulesRevision: 1
    title: "Kontroll\xFC duru\u015F"
    instruction: "Hedefe ilerle ve b\xF6lgede 1 sn boyunca 0,15 m/sn veya alt\u0131nda
      kal."
    start: {x: -3.4, y: 0, z: -3.8}
    startYaw: 0
    gates:
    - position: {x: -3.4, y: 0, z: 2.2}
      radius: 1.25
    targetYaw: 0
    yawTolerance: 0
    stopSpeed: 0.15
    dwellSeconds: 1
  - kind: 2
    exerciseId: precision-turn
    rulesRevision: 1
    title: "Hassas d\xF6n\xFC\u015F"
    instruction: "Merkezden 0,5 m uzakla\u015Fmadan robotu sa\u011Fa \xE7evir. Hedef
      90\xB0, tolerans 5\xB0."
    start: {x: -3.4, y: 0, z: -0.6}
    startYaw: 0
    gates:
    - position: {x: -3.4, y: 0, z: -0.6}
      radius: 0.5
    targetYaw: 90
    yawTolerance: 5
    stopSpeed: 0.15
    dwellSeconds: 1
  - kind: 3
    exerciseId: reverse-parking
    rulesRevision: 1
    title: Geri park
    instruction: "Geri s\u00FCr\u00FC\u015F tu\u015Fuyla hedefe geri gir. Burnu ba\u015Flang\u0131\xE7
      y\xF6n\xFCnde tut ve 1 sn dur."
    start: {x: -3.4, y: 0, z: 2.7}
    startYaw: 0
    gates:
    - position: {x: -3.4, y: 0, z: -1.2}
      radius: 1.05
    targetYaw: 0
    yawTolerance: 8
    stopSpeed: 0.15
    dwellSeconds: 1
